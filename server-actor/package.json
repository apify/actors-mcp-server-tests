{
	"name": "example-server-actor",
	"version": "0.0.1",
	"type": "module",
	"description": "Apify Actor with an HTTP API documented by an OpenAPI schema and an input schema with the same fields.",
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"zod": "^3.25.76",
		"apify": "^3.7.0"
	},
	"devDependencies": {
		"@apify/eslint-config": "^2.0.0",
		"@apify/tsconfig": "^0.1.1",
		"@types/node": "^24.0.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"globals": "^17.0.0",
		"prettier": "^3.5.3",
		"tsx": "^4.20.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.58.0",
		"vitest": "^4.1.0"
	},
	"scripts": {
		"start": "npm run start:dev",
		"start:prod": "node dist/main.js",
		"start:dev": "tsx src/main.ts",
		"build": "tsc",
		"test": "vitest run",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --check src",
		"format:fix": "prettier --write src"
	},
	"author": "It's not you it's me",
	"license": "ISC"
}
